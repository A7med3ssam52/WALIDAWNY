# منصة وليد عونى التعليمية — Environment Variables
# Copy to .env.local for the frontend; Edge Function secrets go via `supabase secrets set` / CI secrets.
# NEVER commit real values. NEVER put service-role/Bunny secrets into VITE_* variables or browser code.

# ── Frontend (public, safe for browser) ───────────────────────────────
# Supabase project URL
VITE_SUPABASE_URL=
# Supabase publishable (anon) key — the only key the browser may hold
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Edge Function secrets (server-side ONLY, via `supabase secrets set` / CI) ──
# Supabase publishable (anon) key — the API-key slot for request-scoped clients
# (the caller JWT travels in the Authorization header). Auto-injected by the
# hosted Edge Runtime; set it explicitly for local `functions serve`.
SUPABASE_ANON_KEY=
# Bunny API key for privileged video operations (create upload session, status queries)
BUNNY_API_KEY=
# Bunny video library ID
BUNNY_LIBRARY_ID=
# Bunny pull zone hostname used when building tokenized playback URLs
BUNNY_PULL_ZONE_HOSTNAME=
# Bunny token-auth signing key (BUNNY_TOKEN_AUTH_SECURITY_KEY) for signed playback URLs
BUNNY_SIGNING_KEY=
# Shared token authenticating Bunny webhook calls — pasted into the Bunny Stream
# webhook URL as ?token=<value> (also accepted via the x-webhook-token header).
# NOTE: Bunny's signature/security-token headers are NOT available on this
# account (R17) — the token-in-URL fallback is the documented design.
# Server-side ONLY.
BUNNY_WEBHOOK_TOKEN=
# Supabase service-role key — used ONLY inside Edge Functions; never in the browser or VITE_*
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for internal job endpoints (e.g. recheck-video-states) — sent as
# header `x-internal-token` by every link of the scheduling chain (managed
# schedule / pg_cron -> pg_net / external cron). Server-side ONLY; never in the browser.
INTERNAL_JOB_TOKEN=

# ── CI / deployment only (GitHub Actions secrets) ─────────────────────
# Supabase personal access token (deploy Edge Functions, link project)
SUPABASE_ACCESS_TOKEN=
# Supabase project ref (e.g. nfusbrktrqfrnaetetmr)
SUPABASE_PROJECT_ID=
# Password for seeded admin/mr_walid users (migration seed, A21)
SEED_ADMIN_PASSWORD=
